# ====== Веб-панель ======
ADMIN_USERNAME=admin
# Сгенерировать: python3 -m app.security_cli hash-password 'мой_пароль'
ADMIN_PASSWORD_HASH=
# Секрет для подписи сессионной cookie — сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Сгенерировать так же, как в DEPLOY.md; не терять ключ после шифрования БД.
CREDENTIALS_ENCRYPTION_KEY=
# Для публичного HTTPS reverse proxy оставьте true. Для локального HTTP используйте false.
SESSION_HTTPS_ONLY=true
HOST=127.0.0.1
PORT=8000

# ====== Telegram-уведомления (опционально) ======
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Почасовой отчёт включён, только если заданы оба параметра выше; отключить: false
TELEGRAM_HOURLY_REPORT_ENABLED=true
TELEGRAM_REPORT_TIMEZONE=Europe/Moscow

# ====== Roller — тайминги (опционально, дефолты уже откалиброваны) ======
# MAX_CREATES_PER_BURST=8
# COOLDOWN_429_SECONDS=480
# COOLDOWN_4XX_SECONDS=60
# COOLDOWN_MAX_SECONDS=960

# ====== Roller — доп. механизмы (опционально) ======
# Сколько delete miss-IP можно держать в полёте одновременно на аккаунт
# DELETE_CONCURRENCY=4
# Как часто (сек) сверять реальный список IP в Selectel с БД. 0 = выключить
# RECONCILER_INTERVAL_SECONDS=180
# Скользящий лимит created/минуту, сглаживает темп запросов. 0 = выключить
# MAX_CREATES_PER_MINUTE=10
# Планировщик выдаёт готовым аккаунтам поочерёдный слот на создание.
# SCHEDULER_LEASE_SECONDS=120
# Общая пауза API включается, если 429 пришёл в нескольких аккаунтах.
# GLOBAL_429_THRESHOLD_ACCOUNTS=2
# GLOBAL_429_WINDOW_SECONDS=120
# Фактическая цена Floating IP в Selectel возьмите из вашего тарифа/счёта.
# При 0 рублёвая оценка выключена; приложение не подставляет выдуманную цену.
# FLOATING_IP_COST_PER_HOUR_RUB=0
# Остановить новые выделения, когда оценка затрат за последние 24 часа
# достигает лимита. 0 = денежный предохранитель выключен; нужна ставка выше.
# MAX_ESTIMATED_DAILY_COST_RUB=0
# Ограничение расчётных затрат за последний час; 0 = выключено.
# MAX_ESTIMATED_HOURLY_COST_RUB=0
# Единые лимиты на весь сервис (а не на каждый аккаунт отдельно).
# MAX_CREATE_OPERATIONS_PER_DAY=100
# MAX_ACTIVE_MANAGED_IPS=20

# Сколько сетевых ошибок подряд в одной зоне терпим короткими паузами,
# прежде чем увести зону в полный карантин
# NETWORK_ERROR_ESCALATE_AFTER=3
# NETWORK_ERROR_BASE_SECONDS=30
# Затяжной простой одной зоны (например, региональный хост Selectel лёг на
# всю ночь) — во сколько раз растёт каждый следующий карантин подряд без
# единого успеха, и потолок (сек), дальше которого не растим
# ZONE_QUARANTINE_GROWTH=2.0
# ZONE_QUARANTINE_MAX_SECONDS=3600
# После скольких карантинов подряд слать алерт в Telegram про зону (если
# Telegram настроен выше)
# ZONE_OUTAGE_ALERT_AFTER=2
